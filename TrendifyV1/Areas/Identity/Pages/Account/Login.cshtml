@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5 pt-5 mb-5" style="min-height: 60vh;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-0">
                <div class="card-header bg-dark text-white rounded-0 py-4 text-center">
                    <h3 class="text-uppercase fw-bold mb-0" style="letter-spacing: 2px;">Влез в профила си</h3>
                </div>
                <div class="card-body p-4 p-md-5 bg-light">
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.Email" class="form-control rounded-0 border-dark" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted text-uppercase small fw-bold">Имейл</label>
                            <span asp-validation-for="Input.Email" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-0 border-dark" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="text-muted text-uppercase small fw-bold">Парола</label>
                            <span asp-validation-for="Input.Password" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input border-dark rounded-0" asp-for="Input.RememberMe" style="cursor: pointer;" />
                                <label asp-for="Input.RememberMe" class="form-check-label small fw-bold" style="cursor: pointer;">
                                    Запомни ме
                                </label>
                            </div>
                            <a asp-area="" asp-controller="Password" asp-action="ForgotPassword" class="твой-клас-за-дизайн">
                                Забравена парола?
                            </a>
                        </div>

                        <div>
                            <button id="login-submit" type="submit" class="btn btn-dark w-100 rounded-0 py-3 text-uppercase fw-bold mb-4" style="letter-spacing: 1px;">
                                Вход
                            </button>
                        </div>

                        <div class="text-center mt-3 pt-3 border-top border-secondary-subtle">
                            <p class="mb-0 small text-muted">
                                Нямаш акаунт?
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-dark fw-bold text-decoration-none text-uppercase ms-1 border-bottom border-dark pb-1">Регистрирай се тук</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}