@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5 pt-5 mb-5" style="min-height: 60vh;">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-0">
                <div class="card-header bg-dark text-white rounded-0 py-4 text-center">
                    <h3 class="text-uppercase fw-bold mb-0" style="letter-spacing: 2px;">Създай профил</h3>
                </div>
                <div class="card-body p-4 p-md-5 bg-light">
                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-0 border-dark" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <label asp-for="Input.Email" class="text-muted text-uppercase small fw-bold">Имейл</label>
                            <span asp-validation-for="Input.Email" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" type="password" class="form-control rounded-0 border-dark" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.Password" class="text-muted text-uppercase small fw-bold">Парола</label>
                            <span asp-validation-for="Input.Password" class="text-danger small fw-bold"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control rounded-0 border-dark" autocomplete="new-password" aria-required="true" placeholder="password" />
                            <label asp-for="Input.ConfirmPassword" class="text-muted text-uppercase small fw-bold">Потвърди паролата</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small fw-bold"></span>
                        </div>

                        <div>
                            <button id="registerSubmit" type="submit" class="btn btn-dark w-100 rounded-0 py-3 text-uppercase fw-bold mb-4" style="letter-spacing: 1px;">
                                Регистрирай ме
                            </button>
                        </div>

                        <div class="text-center mt-3 pt-3 border-top border-secondary-subtle">
                            <p class="mb-0 small text-muted">
                                Вече имаш акаунт?
                                <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-dark fw-bold text-decoration-none text-uppercase ms-1 border-bottom border-dark pb-1">Влез от тук</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}