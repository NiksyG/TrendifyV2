@using TrendifyV1.ViewModels.Category
@model List<CategoryListViewModel>

<h2>Categories</h2>

<a asp-action="Create">Create new</a>

@if (TempData["error"] != null)
{
    <div style="color:red">
        @TempData["error"]
    </div>
}

<table>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Name</td>
            <td>Products: @c.ProductsCount</td>

            <td>
                <a asp-action="Edit" asp-route-id="@c.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@c.Id">Delete</a>
            </td>
        </tr>
    }
</table>