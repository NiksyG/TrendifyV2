@{
    ViewData["Title"] = "Контакти";
}

<div class="container my-5" style="font-family: Arial, sans-serif;">
    <h2 class="fw-bold mb-5">Свържи се с Trendify</h2>

    <div class="row">
        <div class="col-md-7 mb-4">
            <form>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <input type="text" class="form-control rounded-0 py-2" placeholder="Име" required>
                    </div>
                    <div class="col-md-6 mt-3 mt-md-0">
                        <input type="email" class="form-control rounded-0 py-2" placeholder="електронна поща" required>
                    </div>
                </div>
                <div class="mb-3">
                    <input type="tel" class="form-control rounded-0 py-2" placeholder="Телефонен номер">
                </div>
                <div class="mb-3">
                    <textarea class="form-control rounded-0" rows="6" placeholder="Съобщение" required></textarea>
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input rounded-0" type="checkbox" id="saveInfo">
                    <label class="form-check-label small fw-bold" for="saveInfo">
                        Запазете моето име, имейл и уебсайт в този браузър за следващия път, когато коментирам.
                    </label>
                </div>
                <button type="submit" class="btn btn-dark rounded-0 px-5 py-2 fw-bold">Изпратете сега</button>
            </form>
        </div>

        <div class="col-md-4 offset-md-1">
            <h5 class="fw-bold mb-3">Контакти</h5>
            <p class="mb-1 fw-bold">+359882447940</p>
            <p class="mb-5 fw-bold">office.trendify@gmail.com</p>

            <h5 class="fw-bold mb-3">Работно време</h5>
            <p class="mb-1 fw-bold">Свържи се с нас във всеки един работен ден на посочения имейл или тел. номер!</p>
            <p class="mb-5 fw-bold">9:00 - 17:00</p>

            <h5 class="fw-bold mb-3">Информация</h5>
            <p class="mb-1 fw-bold text-uppercase">ТРЕНДИФАЙ ООД</p>
            <p class="mb-1 fw-bold">BG206255141</p>
            <p class="mb-0 fw-bold">ул. Шипка 6, град София 1000</p>
        </div>
    </div>
</div>