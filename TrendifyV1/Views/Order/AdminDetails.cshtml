@model TrendifyV1.ViewModels.OrderAdminViewModels.OrderDetailsAdminViewModel
<div class="container mt-5 pt-4 mb-5">
    <div class="mb-4">
        <a asp-action="AdminIndex" class="text-dark text-decoration-none small fw-bold text-uppercase">
            <i class="bi bi-arrow-left"></i> Назад към поръчките
        </a>
    </div>

    <div class="row gx-lg-5">
        <div class="col-lg-4">
            <div class="card border-dark rounded-0 mb-4">
                <div class="card-header bg-dark text-white rounded-0 py-3">
                    <h6 class="text-uppercase fw-bold mb-0">Данни за доставка</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1 small text-muted text-uppercase fw-bold">Имена:</p>
                    <p class="fw-bold mb-3">@Model.FullName</p>

                    <p class="mb-1 small text-muted text-uppercase fw-bold">Телефон:</p>
                    <p class="fw-bold mb-3">@Model.Phone</p>

                    <p class="mb-1 small text-muted text-uppercase fw-bold">Град:</p>
                    <p class="fw-bold mb-3">@Model.City</p>

                    <p class="mb-1 small text-muted text-uppercase fw-bold">Адрес:</p>
                    <p class="fw-bold">@Model.Address</p>
                </div>
            </div>

            <div class="card border-dark rounded-0">
                <div class="card-body py-3">
                    <p class="mb-2 small text-muted text-uppercase fw-bold">Статус на поръчката:</p>
                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <select name="status" class="form-select border-dark rounded-0 fw-bold text-uppercase" style="width: auto; font-size: 0.85rem;">
                            <option value="Обработва се" selected="@(Model.Status == "Обработва се")">Обработва се</option>
                            <option value="Изпратена" selected="@(Model.Status == "Изпратена")">Изпратена</option>
                            <option value="Доставена" selected="@(Model.Status == "Доставена")">Доставена</option>
                            <option value="Отказана" selected="@(Model.Status == "Отказана")">Отказана</option>
                        </select>
                        <button type="submit" class="btn btn-dark rounded-0 text-uppercase fw-bold" style="font-size: 0.85rem;">Запази</button>
                    </form>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success rounded-0 mt-3 p-2 small fw-bold mb-0">
                            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <h5 class="text-uppercase fw-bold mb-4">Продукти в поръчката</h5>
            <div class="table-responsive border">
                <table class="table align-middle mb-0">
                    <thead class="bg-light small fw-bold text-uppercase">
                        <tr>
                            <th class="ps-3">Продукт</th>
                            <th>Размер</th>
                            <th>Брой</th>
                            <th class="text-end pe-3">Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.ProductName</td>
                                <td><span class="badge border text-dark rounded-0">@item.Size</span></td>
                                <td>@item.Quantity бр.</td>
                                <td class="text-end pe-3">@item.Price.ToString("F2") €</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-bold fs-5">
                        <tr>
                            <td colspan="3" class="ps-3 text-uppercase">Обща сума:</td>
                            <td class="text-end pe-3 text-danger">@Model.TotalAmount.ToString("F2") €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>