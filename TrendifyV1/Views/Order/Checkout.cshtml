@model TrendifyV1.ViewModels.CheckoutViewModel.CheckoutViewModel

<div class="container mt-5 pt-5 mb-5">
    <h2 class="text-uppercase fw-bold mb-5 border-bottom pb-3">Завършване на поръчката</h2>
    <form asp-action="Checkout" method="post">
        <div class="row">
            <div class="col-lg-7 pe-lg-5">
                <h5 class="text-uppercase fw-bold mb-4">Данни за доставка</h5>

                <div class="mb-3">
                    <label asp-for="FullName" class="small fw-bold text-uppercase"></label>
                    <input asp-for="FullName" class="form-control rounded-0 border-dark" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="small fw-bold text-uppercase"></label>
                        <input asp-for="Phone" class="form-control rounded-0 border-dark" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="City" class="small fw-bold text-uppercase"></label>
                        <input asp-for="City" class="form-control rounded-0 border-dark" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Address" class="small fw-bold text-uppercase"></label>
                    <textarea asp-for="Address" class="form-control rounded-0 border-dark" rows="3"></textarea>
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <h5 class="text-uppercase fw-bold mb-4 mt-5">Метод на плащане</h5>
                <div class="form-check mb-2">
                    <input class="form-check-input border-dark" type="radio" asp-for="PaymentMethod" value="CashOnDelivery" checked>
                    <label class="form-check-label fw-bold">Наложен платеж (плащане при доставка)</label>
                </div>
            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">
                <div class="bg-light p-4 border border-dark h-100">
                    <h5 class="text-uppercase fw-bold mb-4">Твоята поръчка</h5>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span>Междинна сума:</span>
                        <span class="fw-bold">@Model.TotalAmount.ToString("F2") €</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-2">
                        <span>Доставка:</span>
                        <span class="text-success fw-bold text-uppercase">Безплатна</span>
                    </div>
                    <div class="d-flex justify-content-between fs-4 fw-bold mb-5 mt-4">
                        <span>ОБЩО:</span>
                        <span>@Model.TotalAmount.ToString("F2") €</span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 rounded-0 py-3 text-uppercase fw-bold">
                        Потвърди поръчката
                    </button>

                    <p class="text-muted small text-center mt-3 mb-0">
                        Натискайки бутона, вие се съгласявате с нашите Общи условия.
                    </p>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}