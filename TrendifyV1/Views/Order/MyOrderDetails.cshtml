@model TrendifyV1.ViewModels.UserOrderViewModels.MyOrderDetailsViewModel

<div class="container mt-5 pt-4 mb-5">
    <div class="mb-4">
        <a asp-action="MyOrders" class="text-dark text-decoration-none small fw-bold text-uppercase">
            <i class="bi bi-arrow-left"></i> Назад към моите поръчки
        </a>
    </div>

    <h3 class="text-uppercase fw-bold mb-4">Поръчка #@Model.Id</h3>

    <div class="row gx-lg-5">
        <div class="col-lg-4 mb-4">
            <div class="card border-dark rounded-0 mb-4">
                <div class="card-body py-4 text-center">
                    <p class="mb-2 small text-muted text-uppercase fw-bold">Текущ статус:</p>
                    <h4 class="text-uppercase fw-bold text-primary mb-0">@Model.Status</h4>
                </div>
            </div>

            <div class="card border-dark rounded-0">
                <div class="card-header bg-dark text-white rounded-0 py-3">
                    <h6 class="text-uppercase fw-bold mb-0">Данни за доставка</h6>
                </div>
                <div class="card-body">
                    <p class="mb-1 small text-muted fw-bold">Имена:</p>
                    <p class="fw-bold mb-3">@Model.FullName</p>
                    <p class="mb-1 small text-muted fw-bold">Телефон:</p>
                    <p class="fw-bold mb-3">@Model.Phone</p>
                    <p class="mb-1 small text-muted fw-bold">Адрес:</p>
                    <p class="fw-bold mb-0">@Model.City, @Model.Address</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="table-responsive border">
                <table class="table align-middle mb-0">
                    <thead class="bg-light small fw-bold text-uppercase">
                        <tr>
                            <th class="ps-3">Продукт</th>
                            <th>Размер</th>
                            <th>Брой</th>
                            <th class="text-end pe-3">Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">@item.ProductName</td>
                                <td>@item.Size</td>
                                <td>@item.Quantity</td>
                                <td class="text-end pe-3">@item.Price.ToString("F2") €</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-bold fs-5">
                        <tr>
                            <td colspan="3" class="ps-3 text-uppercase">Общо платено:</td>
                            <td class="text-end pe-3">@Model.TotalAmount.ToString("F2") €</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>