@model TrendifyV1.ViewModels.AccountViewModels.ResetPasswordFastViewModel

<div class="container mt-5 pt-5 mb-5 d-flex justify-content-center" style="min-height: 60vh;">
    <div class="card rounded-0 border-dark shadow-sm" style="width: 100%; max-width: 450px;">
        <div class="card-header bg-black text-white rounded-0 py-3 text-center">
            <h5 class="text-uppercase fw-bold mb-0" style="letter-spacing: 1px;">Забравена парола</h5>
        </div>
        <div class="card-body p-4 p-md-5">
            <p class="text-muted small mb-4 text-center">
                Въведи имейла, с който си регистриран, и желаната от теб нова парола.
            </p>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small fw-bold mb-3 text-center"></div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold small">Имейл</label>
                    <input asp-for="Email" class="form-control rounded-0 border-dark" placeholder="твойимейл@email.com" />
                    <span asp-validation-for="Email" class="text-danger small fw-bold"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold small">Нова парола</label>
                    <input asp-for="NewPassword" type="password" class="form-control rounded-0 border-dark" placeholder="Въведи нова парола" />
                    <span asp-validation-for="NewPassword" class="text-danger small fw-bold"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label text-uppercase fw-bold small">Потвърди паролата</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control rounded-0 border-dark" placeholder="Повтори новата парола" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small fw-bold"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 rounded-0 text-uppercase fw-bold py-2 mt-2">
                    Възстанови
                </button>

                <div class="text-center mt-4">
                    <a href="/Identity/Account/Login" class="text-dark text-decoration-none small text-uppercase fw-bold">
                        <i class="bi bi-arrow-left"></i> Назад към логин
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}