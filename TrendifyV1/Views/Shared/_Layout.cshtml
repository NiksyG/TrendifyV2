<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - TrendifyV1</title>
    <link rel="icon" type="image/png" href="/images/BlackandWhiteLogo.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TRENDIFY | Official Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrendifyV1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body style="margin: 0; padding: 0;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-black border-bottom-dark shadow-sm">
            <div class="container-fluid">
                <div class="row w-100 align-items-center m-0">
                    <div class="col-4 p-0">
                        <div class="navbar-collapse collapse d-sm-inline-flex ms-5">
                            <ul class="navbar-nav align-items-center">
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase fw-bold" asp-controller="Product" asp-action="Index">Магазин</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-uppercase fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Колекции
                                    </a>
                                    <ul class="dropdown-menu bg-black border-secondary" aria-labelledby="navbarDropdown">
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Горнища">Горнища</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Долнища">Долнища</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Тениски">Тениски</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Къси Панталони">Къси панталони</a></li>
                                        <li><hr class="dropdown-divider bg-secondary"></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Аксесоари">Аксесоари</a></li>
                                    </ul>
                                </li>

                                @if (User.IsInRole("Administrator"))
                                {
                                    <li class="nav-item ms-3 border-start border-secondary ps-3">
                                        <a class="nav-link text-uppercase fw-bold text-warning" asp-controller="Order" asp-action="AdminIndex">
                                            Поръчки
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="col-4 d-flex justify-content-center p-0">
                        <a class="navbar-brand m-0 p-0" asp-controller="Home" asp-action="Index">
                            <img src="/images/Screenshot 2026-03-26 151635.png" alt="Trendify Logo"
                                 style="height: 110px; width: auto; display: block; filter: invert(1); padding: 10px 0;" />
                        </a>
                    </div>

                    <div class="col-4 d-flex justify-content-end align-items-center p-0">
                        <partial name="_LoginPartial" />
                        <a class="nav-link ms-3 p-0 d-flex align-items-center position-relative"
                           href="javascript:void(0);"
                           data-bs-toggle="offcanvas"
                           data-bs-target="#cartDrawer"
                           style="border: none; background: none; text-decoration: none; width: 35px; height: 35px;">
                            <img src="/images/cart-icon.png.png" alt="Cart" style="height: 28px; width: auto; display: block; filter: invert(1); pointer-events: none;" asp-append-version="true" />
                            <span class="position-absolute badge rounded-pill bg-danger" id="cartBadge"
                                  style="font-size: 0.6rem; padding: 0.3em 0.45em; top: -5px; right: -10px; border: 2px solid #000; z-index: 2;">
                                0
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="text-white pt-5 pb-4" style="background-color: #000; font-family: Arial, sans-serif;">
        <div class="container-fluid px-5">
            <div class="row">
                <div class="col-md-2 mb-4">
                    <h6 class="text-uppercase fw-bold mb-4 text-secondary">Trendify</h6>
                    <ul class="list-unstyled small fw-bold">
                        <li class="mb-3"><a asp-controller="Info" asp-action="About" class="text-white text-decoration-none">За нас</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="FAQ" class="text-white text-decoration-none">Въпроси</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="Contacts" class="text-white text-decoration-none">Контакти</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="Shipping" class="text-white text-decoration-none">Доставка</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="Returns" class="text-white text-decoration-none">Замяна и Връщане</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-4">
                    <h6 class="text-uppercase fw-bold mb-4 text-secondary">Политики</h6>
                    <ul class="list-unstyled small fw-bold">
                        <li class="mb-3"><a asp-controller="Info" asp-action="Terms" class="text-white text-decoration-none">Общи условия</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="Rules" class="text-white text-decoration-none">Условия и Правила</a></li>
                        <li class="mb-3"><a asp-controller="Info" asp-action="Privacy" class="text-white text-decoration-none">Поверителност</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="text-uppercase fw-bold mb-4 text-secondary">Магазин</h6>
                    <p class="mb-1 fw-bold">+359882447940</p>
                    <p class="mb-4 fw-bold">office.trendify@gmail.com</p>
                    <div>
                        <a href="https://www.instagram.com/niksyg_/" target="_blank" rel="noopener noreferrer" class="btn btn-outline-light rounded-circle me-2">
                            <i class="bi bi-instagram"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="offcanvas offcanvas-end bg-black text-white" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel" style="width: 400px;">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title text-uppercase fw-bold" id="cartDrawerLabel">Твоята количка</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="cartContent">
                <p class="text-center mt-5 text-muted">Количката е празна.</p>
            </div>
        </div>
        <div class="offcanvas-footer p-4 border-top border-secondary bg-black">
            <div class="d-flex justify-content-between mb-3 fw-bold fs-5">
                <span class="text-uppercase">Общо:</span>
                <span id="cartTotal">0.00 €.</span>
            </div>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-light w-100 py-3 text-uppercase fw-bold rounded-0">Завърши поръчката</a>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function updateMiniCart() {
            fetch('/Basket/GetMiniCart')
                .then(response => response.text())
                .then(html => {
                    const cartContent = document.getElementById('cartContent');
                    if (cartContent) cartContent.innerHTML = html;

                    const hiddenTotal = document.getElementById('hiddenCartTotal');
                    if (hiddenTotal) document.getElementById('cartTotal').innerText = hiddenTotal.value;

                    const hiddenCount = document.getElementById('hiddenCartCount');
                    if (hiddenCount) document.getElementById('cartBadge').innerText = hiddenCount.value;
                })
                .catch(error => console.error('Грешка при зареждане:', error));
        }

        function openSideCart() {
            var cartDrawer = document.getElementById('cartDrawer');
            var bsOffcanvas = bootstrap.Offcanvas.getInstance(cartDrawer);
            if (!bsOffcanvas) bsOffcanvas = new bootstrap.Offcanvas(cartDrawer);
            bsOffcanvas.show();
        }

        function removeFromCart(itemId) {
            fetch('/Basket/RemoveAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + itemId
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateMiniCart();
                } else {
                    alert("Грешка: " + data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }
        function changeQuantity(itemId, delta) {
            fetch('/Basket/UpdateQuantityAjax', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + itemId + '&delta=' + delta
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    updateMiniCart();
                } else {
                    alert("Грешка: " + data.message);
                }
            })
            .catch(error => console.error('Error:', error));
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateMiniCart();
        });
    </script>
</body>
</html>