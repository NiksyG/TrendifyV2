<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TRENDIFY | Official Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TrendifyV1.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body style="margin: 0; padding: 0;">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-black border-bottom-dark shadow-sm">
            <div class="container-fluid">
                <div class="row w-100 align-items-center m-0">

                    <div class="col-4 p-0">
                        <div class="navbar-collapse collapse d-sm-inline-flex">
                            <ul class="navbar-nav">
                                <li class="nav-item">
                                    <a class="nav-link text-uppercase fw-bold" asp-controller="Product" asp-action="Index">Магазин</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-uppercase fw-bold" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Колекции
                                    </a>
                                    <ul class="dropdown-menu bg-black border-secondary" aria-labelledby="navbarDropdown">
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Gornishta">Горнища</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Dolnishta">Долнища</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Teniski">Тениски</a></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="KasiPantaloni">Къси панталони</a></li>
                                        <li><hr class="dropdown-divider bg-secondary"></li>
                                        <li><a class="dropdown-item text-white text-uppercase" asp-controller="Product" asp-action="Index" asp-route-category="Aksesoari">Аксесоари</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-4 d-flex justify-content-center p-0">
                        <a class="navbar-brand m-0 p-0" asp-controller="Home" asp-action="Index">
                            <img src="/images/Screenshot 2026-03-26 151635.png" alt="Trendify Logo"
                                 style="height: 110px; width: auto; display: block; filter: invert(1); padding: 10px 0;" />
                        </a>
                    </div>

                    <div class="col-4 d-flex justify-content-end align-items-center p-0">
                        <partial name="_LoginPartial" />
                        <a class="nav-link ms-3 p-0 d-flex align-items-center position-relative"
                           href="javascript:void(0);"
                           data-bs-toggle="offcanvas"
                           data-bs-target="#cartDrawer"
                           style="border: none; background: none; text-decoration: none; width: 35px; height: 35px;">
                            <img src="/images/cart-icon.png.png" alt="Cart" style="height: 28px; width: auto; display: block; filter: invert(1); pointer-events: none;" asp-append-version="true" />
                            <span class="position-absolute badge rounded-pill bg-danger" id="cartBadge"
                                  style="font-size: 0.6rem; padding: 0.3em 0.45em; top: -5px; right: -10px; border: 2px solid #000; z-index: 2;">
                                0
                            </span>
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer py-4 bg-black border-top border-secondary">
        <div class="container text-center">
            <p class="small text-uppercase mb-0" style="letter-spacing: 3px; color: #666; font-size: 0.75rem;">
                &copy; 2026 TRENDIFY OFFICIAL. ALL RIGHTS RESERVED.
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="offcanvas offcanvas-end bg-black text-white" tabindex="-1" id="cartDrawer" aria-labelledby="cartDrawerLabel" style="width: 400px;">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title text-uppercase fw-bold" id="cartDrawerLabel">Твоята количка</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <div id="cartContent">
                <p class="text-center mt-5 text-muted">Количката е празна.</p>
            </div>
        </div>
        <div class="offcanvas-footer p-4 border-top border-secondary bg-black">
            <div class="d-flex justify-content-between mb-3 fw-bold fs-5">
                <span class="text-uppercase">Общо:</span>
                <span id="cartTotal">0.00 лв.</span>
            </div>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-light w-100 py-3 text-uppercase fw-bold rounded-0">Завърши поръчката</a>
        </div>
    </div>
</body>
</html>