@model TrendifyV1.ViewModels.BasketViewModels.BasketViewModel

@if (Model == null || !Model.Items.Any())
{
    <p class="text-center mt-5 text-muted">Количката е празна.</p>
    <input type="hidden" id="hiddenCartTotal" value="0.00 €." />
    <input type="hidden" id="hiddenCartCount" value="0" />
}
else
{
    <div class="cart-items-container pb-4">
        @foreach (var item in Model.Items)
        {
            <div class="d-flex mb-4 position-relative border-bottom border-secondary pb-3">
                <div style="width: 85px; height: 105px; background-color: #f8f9fa; flex-shrink: 0;" class="me-3">
                    <img src="@item.ImageUrl" alt="@item.ProductName" class="img-fluid w-100 h-100" style="object-fit: cover;">
                </div>

                <div class="flex-grow-1 text-white">
                    <h6 class="text-uppercase fw-bold mb-1" style="font-size: 0.85rem;">@item.ProductName</h6>
                    <p class="text-muted small mb-2">Размер: @item.Size</p>
                    <p class="fw-bold mb-3">@item.Price.ToString("F2") €</p>

                    <div class="d-flex align-items-center justify-content-between">

                        <div class="input-group border border-secondary" style="width: 100px; height: 32px;">
                            <button class="btn btn-dark text-white border-0 rounded-0 px-2 fw-bold" onclick="changeQuantity(@item.Id, -1)" type="button" style="line-height: 1;">-</button>

                            <input type="text" class="form-control bg-transparent text-white border-0 text-center p-0 fw-bold" value="@item.Quantity" readonly style="font-size: 0.9rem;">

                            <button class="btn btn-dark text-white border-0 rounded-0 px-2 fw-bold" onclick="changeQuantity(@item.Id, 1)" type="button" style="line-height: 1;">+</button>
                        </div>
                        <button type="button" onclick="removeFromCart(@item.Id)" class="btn btn-link text-muted text-decoration-underline p-0 small">Премахни</button>
                    </div>
                </div>
            </div>
        }
    </div>

    <input type="hidden" id="hiddenCartTotal" value="@Model.TotalAmount.ToString("F2") €." />
    <input type="hidden" id="hiddenCartCount" value="@Model.Items.Sum(i => i.Quantity)" />
}